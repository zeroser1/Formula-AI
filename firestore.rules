rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teamCounts/{teamId} {
      function validTeam() {
        return teamId in ['gcf','demand-generation','cvg-ventas','o2i','legales','marketing'];
      }
      function validCount() {
        return request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.keys().hasAll(['count'])
          && request.resource.data.count is int;
      }
      allow read: if validTeam();
      allow create: if validTeam() && validCount() && request.resource.data.count == 1;
      allow update: if validTeam() && validCount()
        && resource.data.count is int
        && resource.data.count >= 0
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
  }
}
